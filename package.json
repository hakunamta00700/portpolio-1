{
  "name": "portpolio_1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "mikro-orm migration:up && next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "db:generate": "mikro-orm migration:create",
    "db:migrate": "mikro-orm migration:up",
    "db:migrate:prod": "dotenv -e .env.prod -- mikro-orm migration:up",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:seed:prod": "dotenv -e .env.prod -- tsx src/lib/db/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@mikro-orm/core": "^6.6.9",
    "@mikro-orm/migrations": "^6.6.9",
    "@mikro-orm/postgresql": "^6.6.9",
    "@mikro-orm/sqlite": "^6.6.9",
    "@supabase/supabase-js": "^2.99.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.577.0",
    "next": "16.1.7",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "resend": "^6.9.4",
    "shadcn": "^4.0.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./mikro-orm.config.ts"
    ]
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.6.9",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
